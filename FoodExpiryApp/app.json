{
  "expo": {
    "name": "Expiry Alert",
    "slug": "expiry-alert-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/food_expiry_logo.png",
    "userInterfaceStyle": "automatic",
    "scheme": "expiryalert",
    "description": "Never let food go to waste again! Track expiration dates, organize your pantry, and reduce food waste with our intuitive food management app.",
    "splash": {
      "image": "./assets/food_expiry_logo_adaptive.png",
      "resizeMode": "contain",
      "backgroundColor": "#006b29"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.expiryalert.app",
      "buildNumber": "3",
      "infoPlist": {
        "NSCameraUsageDescription": "This app uses the camera to scan barcodes for adding food items quickly.",
        "NSPhotoLibraryUsageDescription": "This app accesses photo library to save food item images for better organization.",
        "NSPhotoLibraryAddUsageDescription": "This app saves photos of your food items to help you organize your pantry.",
        "NSDocumentsFolderUsageDescription": "This app stores food item images in your device's secure document folder.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIFileSharingEnabled": false,
        "LSSupportsOpeningDocumentsInPlace": false
      },
      "requireFullScreen": false,
      "userInterfaceStyle": "automatic"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/food_expiry_logo_adaptive.png",
        "backgroundColor": "#006b29"
      },
      "splash": {
        "image": "./assets/food_expiry_logo_adaptive.png",
        "resizeMode": "contain",
        "backgroundColor": "#006b29"
      },
      "package": "com.expiryalert.app",
      "versionCode": 3,
      "permissions": [
        "CAMERA",
        "RECEIVE_BOOT_COMPLETED",
        "VIBRATE",
        "WAKE_LOCK",
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "INTERNET",
        "com.android.vending.BILLING"
      ]
    },
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#006b29",
          "image": "./assets/food_expiry_logo_adaptive.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "newArchEnabled": true
          },
          "ios": {
            "newArchEnabled": true,
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-sqlite",
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-system-ui",
      [
        "expo-image-picker",
        {
          "photosPermission": "The app accesses your photos to let you share them as food item images.",
          "cameraPermission": "The app accesses your camera to let you take photos of food items."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cb2a08f8-33c5-4312-8a50-44c6e71f0778"
      }
    },
    "owner": "123ang"
  }
}
