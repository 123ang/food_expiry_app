server {
    server_name expiry-alert.link www.expiry-alert.link;

    root /root/projects/food_expiry_app/web-app/expiry-alert/build;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/json;

    # Serve static files
    location / {
        try_files $uri $uri/ /index.html;
        expires -1;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/expiry-alert.link/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/expiry-alert.link/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}
server {
    if ($host = www.expiry-alert.link) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = expiry-alert.link) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name expiry-alert.link www.expiry-alert.link;
    return 404; # managed by Certbot




}
